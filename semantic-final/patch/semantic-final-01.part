     }
 
+    private void initializeSemanticEngine() {
+        if (!ocrEnabled) return;
+        setStatus("Încarc modelul semantic explicit offline…", Color.rgb(244, 188, 77));
+        analysisExecutor.execute(() -> {
+            try {
+                SemanticAnalyzer engine = new SemanticAnalyzer(getApplicationContext());
+                semanticAnalyzer = engine;
+                semanticReady = true;
+                semanticFailure = "";
+                runOnUiThread(() -> setStatus(
+                        semanticQuery.isEmpty()
+                                ? "Semantic explicit pregătit • detecție TOPIC/NOD"
+                                : "Semantic explicit pregătit • caut: " + semanticQuery,
+                        Color.rgb(78, 201, 126)
+                ));
+            } catch (Throwable error) {
+                semanticReady = false;
+                semanticFailure = error.getClass().getSimpleName() + ": " + String.valueOf(error.getMessage());
+                runOnUiThread(() -> setStatus(
+                        "Semantic indisponibil • fallback lexical",
+                        Color.rgb(235, 100, 100)
+                ));
+            }
+        });
+    }
+
+    private List<MatchHit> lexicalFallback(Text text) {
+        TopicMatcher.SearchPlan activePlan = searchPlan;
+        if (activePlan == null) {
+            TopicMap activeMap = topicMap == null ? TopicMapStore.load(MainActivity.this) : topicMap;
+            activePlan = TopicMatcher.compile(MainActivity.this, activeMap);
+            searchPlan = activePlan;
+        }
+        return TopicMatcher.find(text, activePlan);
+    }
+
+    private void submitSemanticSearch() {
+        String next = semanticSearchInput == null ? "" : semanticSearchInput.getText().toString().trim();
+        semanticQuery = next;
+        latestAllHits = Collections.emptyList();
+        overlayView.clearHits();
+        updateLegend(Collections.emptyList());
+        InputMethodManager keyboard = (InputMethodManager) getSystemService(INPUT_METHOD_SERVICE);
+        if (keyboard != null && semanticSearchInput != null) {
+            keyboard.hideSoftInputFromWindow(semanticSearchInput.getWindowToken(), 0);
+        }
+        if (!semanticReady) {
+            setStatus("Motorul semantic încă nu este disponibil • verifică modelul", Color.rgb(244, 188, 77));
+        } else if (next.isEmpty()) {
+            setStatus("Semantic explicit • mod TOPIC/NOD automat", Color.rgb(78, 201, 126));
+        } else {
+            setStatus("Semantic explicit • caut: " + next, Color.rgb(78, 201, 126));
+        }
+    }
+
+    private void cycleSemanticDetail() {
+        semanticDetailLevel = (semanticDetailLevel + 1) % 3;
+        overlayView.setDetailLevel(semanticDetailLevel);
+        if (semanticDetailLevel == 0) semanticDetailButton.setText("ZOOM: TOPIC");
+        else if (semanticDetailLevel == 1) semanticDetailButton.setText("ZOOM: IDEE");
+        else semanticDetailButton.setText("ZOOM: DETALIU");
+        redrawVisibleHits();
+    }
+
     private void toggleOcr() {
         ocrEnabled = !ocrEnabled;
         AppPrefs.setOcrEnabled(this, ocrEnabled);
