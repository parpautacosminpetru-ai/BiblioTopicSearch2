     private void showHitDetails(MatchHit hit) {
+        if (hit != null && hit.semantic) {
+            StringBuilder message = new StringBuilder();
+            message.append("MOD: SEMANTIC EXPLICIT-ONLY")
+                    .append("\nFără inferență implicită • fără interpretare generativă")
+                    .append("\n\nTOPIC / NOD: ").append(hit.node.path)
+                    .append("\nCATEGORIE: ").append(hit.semanticCategory.isEmpty() ? "—" : hit.semanticCategory)
+                    .append("\nSIMILARITATE: ").append(Math.round(hit.similarity * 100f)).append("%")
+                    .append("\n\nSTART: ").append(hit.evidenceStart)
+                    .append("\nEND: ").append(hit.evidenceEnd);
+            if (!hit.compressionLabels.isEmpty()) {
+                message.append("\n\nETICHETE EXTRACTIVE: ");
+                for (int i = 0; i < hit.compressionLabels.size(); i++) {
+                    if (i > 0) message.append(" · ");
+                    message.append(hit.compressionLabels.get(i));
+                }
+            }
+            if (!hit.relatedTopics.isEmpty()) {
+                message.append("\n\nNODURI ÎNRUDITE EXPLICIT: ");
+                for (String topic : hit.relatedTopics) message.append("\n• ").append(topic);
+            }
+            message.append("\n\nTEXT-DOVADĂ START→END\n").append(hit.originalText);
+            new AlertDialog.Builder(this)
+                    .setTitle("Idee explicită • START→END")
+                    .setMessage(message.toString())
+                    .setPositiveButton("Închide", null)
+                    .show();
+            return;
+        }
+
         DictionaryStore store = new DictionaryStore(this);
