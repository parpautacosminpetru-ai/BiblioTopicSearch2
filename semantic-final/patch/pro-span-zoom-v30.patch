+    private float minRelevance(MatchHit hit) {
+        if (hit.evidenceRelevance == null || hit.evidenceRelevance.isEmpty()) return hit.similarity;
+        float min = Float.POSITIVE_INFINITY;
+        for (Float value : hit.evidenceRelevance) if (value != null) min = Math.min(min, value);
+        return min == Float.POSITIVE_INFINITY ? hit.similarity : min;
+    }
+
+    private float maxRelevance(MatchHit hit) {
+        if (hit.evidenceRelevance == null || hit.evidenceRelevance.isEmpty()) return hit.similarity;
+        float max = Float.NEGATIVE_INFINITY;
+        for (Float value : hit.evidenceRelevance) if (value != null) max = Math.max(max, value);
+        return max == Float.NEGATIVE_INFINITY ? hit.similarity : max;
+    }
+
+    private float normalizeRelevance(float value, float min, float max) {
+        if (max - min < 0.015f) return 0.72f;
+        return clamp((value - min) / (max - min), 0f, 1f);
+    }
+
+    private int relevanceAlpha(float normalized, int level, boolean flashing) {
+        float shaped = level == 1
