+    private void enqueueSemanticFrame(Text text, int recognizedWords) {
+        List<QuerySpec> queries = activeQuerySnapshot();
+        if (queries.isEmpty()) {
+            runOnUiThread(() -> applyHits(Collections.emptyList(), recognizedWords, 0));
+            return;
+        }
+
+        SemanticAnalyzer semantic = semanticAnalyzer;
+        if (!semanticReady || semantic == null) {
+            runOnUiThread(() -> setStatus(
+                    "OCR live • " + queries.size() + " teme active • pregătesc semantic",
+                    Color.rgb(244, 188, 77)
+            ));
+            return;
+        }
+
+        TopicMap activeMap = topicMap == null ? TopicMapStore.load(MainActivity.this) : topicMap;
+        long revision = currentQueryRevision();
+        SemanticFrame frame = new SemanticFrame(text, recognizedWords, revision, queries, activeMap);
+
+        synchronized (semanticQueueLock) {
+            // Latest-only semantic backpressure: no inference backlog can accumulate.
+            pendingSemanticFrame = frame;
+            if (semanticWorkerRunning) return;
+            semanticWorkerRunning = true;
+        }
+        semanticExecutor.execute(this::drainSemanticFrames);
+    }
+
+    private void drainSemanticFrames() {
+        while (true) {
+            SemanticFrame frame;
+            synchronized (semanticQueueLock) {
+                frame = pendingSemanticFrame;
+                pendingSemanticFrame = null;
+                if (frame == null) {
+                    semanticWorkerRunning = false;
+                    return;
+                }
+            }
+
+            SemanticAnalyzer semantic = semanticAnalyzer;
+            if (!semanticReady || semantic == null) continue;
+
+            try {
+                List<String> texts = new ArrayList<>(frame.queries.size());
+                for (QuerySpec query : frame.queries) texts.add(query.text);
+
+                List<MatchHit> hits = semantic.analyzeQueries(frame.text, texts, frame.topicMap);
+                List<MatchHit> coloredHits = colorHitsForQueries(hits, frame.queries);
+                if (frame.queryRevision != currentQueryRevision()) continue;
+
+                runOnUiThread(() -> {
+                    if (frame.queryRevision != currentQueryRevision() || frozen || !ocrEnabled) return;
+                    applyHits(coloredHits, frame.recognizedWords, frame.queries.size());
+                });
+            } catch (Throwable semanticError) {
+                semanticFailure = semanticError.getClass().getSimpleName() + ": "
+                        + String.valueOf(semanticError.getMessage());
+                if (frame.queryRevision != currentQueryRevision()) continue;
+                runOnUiThread(() -> setStatus(
+                        "Semantic indisponibil pe cadrul curent • OCR rămâne live",
+                        Color.rgb(235, 100, 100)
+                ));
+            }
+        }
+    }
+
+    private List<MatchHit> colorHitsForQueries(List<MatchHit> hits, List<QuerySpec> queries) {
+        if (hits == null || hits.isEmpty()) return Collections.emptyList();
+        Map<String, QuerySpec> byKey = new LinkedHashMap<>();
+        for (QuerySpec query : queries) byKey.put(query.key, query);
+
+        List<MatchHit> out = new ArrayList<>(hits.size());
+        for (MatchHit hit : hits) {
+            if (hit == null) continue;
+            QuerySpec query = byKey.get(canonicalQuery(hit.searchTerm));
+            if (query == null) continue;
+
+            TopicNode visualNode = new TopicNode("query/" + query.key, query.text, 0);
+            visualNode.enabled = true;
+            visualNode.symbol = "";
+            visualNode.color = query.color;
+            visualNode.terms.add(query.text);
+            out.add(hit.withNode(visualNode));
+        }
+        return out;
+    }
+
+    private boolean addActiveQuery(String text) {
+        String trimmed = text == null ? "" : text.trim();
