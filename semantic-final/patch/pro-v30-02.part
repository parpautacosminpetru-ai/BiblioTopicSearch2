+            if (activeSemanticQueries.containsKey(key)) return false;
+            int color = nextQueryColorLocked();
+            activeSemanticQueries.put(key, new QuerySpec(key, trimmed, color));
+            queryRevision++;
+            return true;
+        }
+    }
+
+    private void removeActiveQuery(String key) {
