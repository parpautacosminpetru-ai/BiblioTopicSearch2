+    public final String evidenceEnd;
+
     public MatchHit(RectF box, String originalText, String searchTerm, TopicNode node, long detectedAt) {
+        this(
+                box,
+                originalText,
+                searchTerm,
+                node,
+                detectedAt,
+                false,
+                false,
+                0f,
+                "",
+                Collections.emptyList(),
+                Collections.emptyList(),
+                Collections.singletonList(new RectF(box)),
+                originalText,
+                originalText
+        );
+    }
+
+    public MatchHit(
+            RectF box,
+            String originalText,
+            String searchTerm,
+            TopicNode node,
+            long detectedAt,
+            boolean semantic,
+            boolean explicitOnly,
+            float similarity,
+            String semanticCategory,
+            List<String> compressionLabels,
+            List<String> relatedTopics,
+            List<RectF> evidenceBoxes,
+            String evidenceStart,
+            String evidenceEnd
+    ) {
         this.box = new RectF(box);
-        this.originalText = originalText;
-        this.searchTerm = searchTerm;
+        this.originalText = originalText == null ? "" : originalText;
+        this.searchTerm = searchTerm == null ? "" : searchTerm;
         this.node = node;
         this.detectedAt = detectedAt;
+        this.semantic = semantic;
+        this.explicitOnly = explicitOnly;
+        this.similarity = similarity;
+        this.semanticCategory = semanticCategory == null ? "" : semanticCategory;
+        this.compressionLabels = immutableStrings(compressionLabels);
+        this.relatedTopics = immutableStrings(relatedTopics);
+        this.evidenceBoxes = immutableBoxes(evidenceBoxes, box);
+        this.evidenceStart = evidenceStart == null ? "" : evidenceStart;
+        this.evidenceEnd = evidenceEnd == null ? "" : evidenceEnd;
     }
 
     public String identityKey() {
-        return node.path + "|" + searchTerm;
+        String nodePath = node == null || node.path == null ? "" : node.path;
+        if (!semantic) return nodePath + "|" + searchTerm;
+        return "SEM|" + nodePath + "|" + searchTerm + "|" + evidenceStart + "|" + evidenceEnd;
+    }
+
+    private static List<String> immutableStrings(List<String> values) {
+        if (values == null || values.isEmpty()) return Collections.emptyList();
+        return Collections.unmodifiableList(new ArrayList<>(values));
+    }
+
+    private static List<RectF> immutableBoxes(List<RectF> values, RectF fallback) {
+        List<RectF> out = new ArrayList<>();
+        if (values != null) {
+            for (RectF value : values) {
+                if (value != null) out.add(new RectF(value));
+            }
+        }
+        if (out.isEmpty() && fallback != null) out.add(new RectF(fallback));
+        return Collections.unmodifiableList(out);
     }
 }
