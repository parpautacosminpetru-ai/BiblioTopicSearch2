+        for (String label : labels) {
+            if (label == null || label.trim().isEmpty()) continue;
+            if (out.length() > 0) out.append(" · ");
+            out.append(label.trim());
+            if (++count >= limit) break;
+        }
+        return out.toString();
+    }
