+
+        QuerySpec(String key, String text, int color) {
+            this.key = key;
+            this.text = text;
+            this.color = color;
+        }
+    }
+
+    private static final class SemanticFrame {
+        final Text text;
+        final int recognizedWords;
+        final long queryRevision;
+        final List<QuerySpec> queries;
