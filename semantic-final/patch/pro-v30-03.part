+        updateLegend(Collections.emptyList());
+        setStatus(
+                activeQueryCount() == 0
+                        ? "Semantic live • adaugă o temă / idee"
+                        : "Semantic live • " + activeQueryCount() + " teme/idei active",
+                Color.rgb(78, 201, 126)
+        );
+    }
+
+    private void invalidateSemanticResults() {
+        invalidateSemanticResults(true);
+    }
+
+    private void invalidateSemanticResults(boolean bumpRevision) {
+        if (bumpRevision) {
+            synchronized (activeSemanticQueries) {
+                queryRevision++;
+            }
+        }
+        synchronized (semanticQueueLock) {
+            pendingSemanticFrame = null;
+        }
+        latestAllHits = Collections.emptyList();
+        if (overlayView != null) overlayView.clearHits();
+    }
+
+    private int activeQueryCount() {
+        synchronized (activeSemanticQueries) {
+            return activeSemanticQueries.size();
+        }
+    }
+
+    private long currentQueryRevision() {
+        synchronized (activeSemanticQueries) {
+            return queryRevision;
+        }
+    }
+
+    private boolean isActiveQuery(String query) {
+        String key = canonicalQuery(query);
+        synchronized (activeSemanticQueries) {
+            return activeSemanticQueries.containsKey(key);
+        }
+    }
+
+    private List<QuerySpec> activeQuerySnapshot() {
+        synchronized (activeSemanticQueries) {
+            return new ArrayList<>(activeSemanticQueries.values());
+        }
+    }
+
+    private int nextQueryColorLocked() {
+        Set<Integer> used = new HashSet<>();
+        for (QuerySpec query : activeSemanticQueries.values()) used.add(query.color);
+        for (int color : QUERY_COLORS) if (!used.contains(color)) return color;
+        return QUERY_COLORS[activeSemanticQueries.size() % QUERY_COLORS.length];
+    }
+
+    private String canonicalQuery(String value) {
+        if (value == null) return "";
+        return java.text.Normalizer.normalize(value.trim().toLowerCase(java.util.Locale.ROOT),
+                        java.text.Normalizer.Form.NFD)
+                .replaceAll("\\p{M}+", "")
+                .replaceAll("\\s+", " ")
+                .trim();
+    }
+
